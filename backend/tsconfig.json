{
  "compilerOptions": {
     "types": ["node", "uuid"],
    "typeRoots": ["node_modules/@types"],
    "removeComments": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "outDir": "./dist",
    "incremental": true,
    "noImplicitAny": true,
    "alwaysStrict": true,

    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "commonjs",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "ignoreDeprecations": "5.0",

  },
  "exclude": [
    "node_modules",
    "tmp",
    "prisma/generated"
  ],
  "include": [
    "src"
  ]
}
