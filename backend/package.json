{
  "name": "devbasenestprisma",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "docker:up": "docker-compose -f '../db/docker-compose.yml' --env-file ../.env up -d --build",
    "docker:down": "docker-compose -f '../db/docker-compose.yml' --env-file ../.env down",
    "start:db": "npm run prisma:generate && npm run prisma-migrate",
    "prisma-reset": "pnpm exec prisma migrate reset",
    "start:dev": "dotenv -e ../.env -- nest start --watch",
    "start:dev-i18copy": "npm run copy-assets && npm run start:dev",
    "pnpm-auto-update": "pnpm update",
    "prisma:studio": "dotenv -e ../.env -- npx prisma studio",
    "seed": "dotenv -e ../.env ts-node prisma/seed.ts",
    "seedFromFiles": "npx prisma db seed",
    "pnpm-instal": "pnpm install --no-frozen-lockfile",
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "copy-assets": "cp -rv src/i18n dist/src/",
    "start": "nest start",
    "prisma:generate": "npx prisma generate",
    "prisma:generate:watch": "npx prisma generate --watch",
    "prisma-migrate": "dotenv -e ../.env -- npx prisma migrate dev",
    "postbuild": "npm run prisma:generate"

  },
  "dependencies": {
    "@biesbjerg/ngx-translate-extract-marker": "^1.0.0",
    "@nestjs-modules/mailer": "^2.0.2",
    "@nestjs/common": "^11.1.9",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.9",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.9",
    "@nestjs/swagger": "^11.2.3",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "acorn": "8.15.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.2.3",
    "dotenv-cli": "^11.0.0",
    "express": "5.1.0",
    "fs-extra": "^11.3.2",
    "joi": "^18.0.2",
    "jsonwebtoken": "^9.0.2",
    "ms": "^2.1.3",
    "nestjs-i18n": "^10.5.1",
    "nodemailer": "7.0.10",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "password-hash-and-salt": "^0.1.4",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.1.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.34.5",
    "swagger-ui-express": "^5.0.1",
    "tslib": "^2.8.1",
    "typesync": "^0.14.3",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.51.1",
    "@faker-js/faker": "10.1.0",
    "@nestjs/cli": "^11.0.12",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "11.1.9",
    "@types/eslint": "^9.6.1",
    "@types/eslint-plugin-prettier": "^3.1.3",
    "@types/express": "^5.0.5",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/ms": "^2.1.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.1",
    "@types/nodemailer": "^7.0.4",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/password-hash-and-salt": "^0.1.2",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^11.0.0",
    "@types/validator": "13.15.10",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^30.2.0",
    "nestjs-prisma": "^0.26.0",
    "pnpm": "^10.23.0",
    "prettier": "^3.6.2",
    "prisma": "^7.0.0",
    "prisma-dbml-generator": "^0.12.0",
    "prisma-json-schema-generator": "^5.1.5",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "prisma": {
      "seed": "ts-node prisma/seed.ts"
    }
  }
}
